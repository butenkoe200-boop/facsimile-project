# ============================================================
# Travel Pay — переменные окружения
# Скопируйте в .env на сервере: cp .env.example .env
# Реальные секреты в Git не коммитятся (.env в .gitignore).
# ============================================================

# Description: целевая платформа сборки Nitro. Для VPS всегда node-server.
# Required: yes (на VPS)
# Used by: build
NITRO_PRESET=node-server

# Description: окружение исполнения приложения
# Required: yes
# Used by: backend (SSR-сервер)
NODE_ENV=production

# Description: порт, на котором слушает Node-сервер (за ним стоит Nginx)
# Required: no (по умолчанию 3000)
# Used by: backend
PORT=3000

# Description: интерфейс прослушивания. 127.0.0.1 — доступ только через Nginx.
# Required: no (по умолчанию 0.0.0.0)
# Used by: backend
HOST=127.0.0.1

# ------------------------------------------------------------
# Ниже — переменные для будущего backend/API. Сейчас приложение
# работает полностью на mock-данных и НЕ требует их.
# Любая переменная, доступная в браузере, должна начинаться с VITE_.
# ------------------------------------------------------------

# Description: базовый URL API. Пусто = относительные пути /api на том же домене.
# Required: no
# Used by: frontend
VITE_API_BASE_URL=

# Description: публичный адрес сайта (для canonical/og-ссылок)
# Required: no
# Used by: frontend
VITE_SITE_URL=https://YOUR_DOMAIN.RU
